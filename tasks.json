{
    "version": "2.0.0",

    "tasks": [

        {
            "label": "Install dependencies",

            "type": "shell",

            "command":
                "python -m pip install -r requirements.txt"
        },

        {
            "label": "Run PocketSmart AI",

            "type": "shell",

            "command":
                "python -m uvicorn app.main:app --reload"
        },

        {
            "label": "Run tests",

            "type": "shell",

            "command":
                "python -m unittest discover -s tests -v"
        }

    ]
}